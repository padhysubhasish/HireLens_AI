# This file is used by `docker compose up` for the backend service.
# Copy it to .env before running: cp .env.example .env

# ---- Auth ----
JWT_SECRET=change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- AI Provider ----
# openai | gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# When true, the app returns deterministic sample AI results instead of
# calling a real LLM, so the full app can be demoed with no API key.
DEMO_MODE=true

# ---- Uploads ----
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/app/uploaded_resumes

# ---- CORS ----
FRONTEND_URL=http://localhost:5173

# NOTE: DATABASE_URL is set directly in docker-compose.yml to point at the
# `db` service. If you run the backend outside Docker, set it yourself,
# e.g. postgresql://postgres:postgres@localhost:5432/resume_screener
